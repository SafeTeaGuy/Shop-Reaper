# ── SUPABASE ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── TIKTOK SHOP PARTNER API ──
TIKTOK_APP_KEY=your-app-key
TIKTOK_APP_SECRET=your-app-secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/callback
# Register at: https://partner.tiktokshop.com
# Required scopes: seller.shop, order.read, product.read, finance.read, logistics.read, aftersale.read

# ── ANTHROPIC (Reaper Coach) ──
ANTHROPIC_API_KEY=your-anthropic-key

# ── STRIPE ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_BASIC_PRICE_ID=price_xxx        # $19/mo
STRIPE_REAPER_PRICE_ID=price_xxx       # $49/mo
STRIPE_AGENCY_PRICE_ID=price_xxx       # $99/mo

# ── TWILIO (SMS alerts) ──
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── INNGEST ──
INNGEST_EVENT_KEY=your-event-key
INNGEST_SIGNING_KEY=your-signing-key

# ── APP ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CASHKING_REFERRAL_CODE=CASHKING
